<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # كل requests تحت /connector/ تروح للـ proxy بدل الـ SPA fallback
  RewriteRule ^connector/ api-proxy.php [L,QSA]

  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
